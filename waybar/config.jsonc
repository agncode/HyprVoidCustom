{
    "position":"top",
    "margin-top":10,
    "modules-left":[
        "custom/archicon",
        "hyprland/workspaces",
        "hyprland/window",
        "mpris",
    ],

    "modules-center":[
        "custom/pacman",
        "clock",
        "tray"
    ],

    "modules-right":[
        "network",
        "pulseaudio",
        "memory",
        "cpu",
        "custom/nvidia",
        "custom/logout",
        "custom/notification",
    ],

    "custom/archicon": {
        "format": " ",
        "tooltip": false,
        "on-click": "exec ~/.config/rofi/launchers/type-3/launcher.sh"
    },

    "hyprland/window": {
        "format": ">  {}",
        "max-length":20,
        "rewrite": {
            "(.*) — Mozilla Firefox": "🌎 $1",
            "(.*) - fish": "> [$1]",
        },
        "separate-outputs": true
    },

    "mpris": {
        "format": "Play   : {player_icon} {dynamic}",
        "format-paused": "Pause: {status_icon} <i>{dynamic}</i>",
        "max-length":25,
        "player-icons": {
            "default": "",
            "mpv": "🎵"
        },
        "status-icons": {
            "paused": "▶"
        },
        // "ignored-players": ["firefox"]
    },

    "custom/pacman":{
        "format":"  {}",
        "interval":"once",
        "exec":"checkupdates | wc -l",
        "on-click":"kitty --hold sudo yay -Syu",
        "signal":8,
        "tooltip-format":"{} updates available"
    },

    "custom/nvidia": {
        "exec": "nvidia-smi --query-gpu=utilization.gpu,temperature.gpu --format=csv,nounits,noheader | sed ' s/\\([0-9]\\+\\), \\([0-9]\\+\\)/\\1%   \\2°C/g'",
        "format": "  {}  GPU",
        "interval": 2
    },

    "custom/logout": {
        "format": "<span size='18pt'>󰈆{}</span>",
        "tooltip-format": "Logout",
        "on-click": "exec wlogout",
        "alignment": "center"
    },


    // "custom/home_folder":{
    //     "format":"󱧶  {}",
    //     "interval":"once",
    //     "exec":"number=$(ls -l | wc -l); number=$((number-1)); echo $number",
    //     "on-click":"kitty --hold ls -l",
    //     "tooltip-format":"{} total files & folders in /"
    // },

    "clock": {
        "interval": 1,
        "format": "{:%H:%M:%S}  󰥔",
        "max-length": 25,
        "tooltip": true,
        "tooltip-format": " {:L%A, %d-%m-%Y} ",
    },

    "hyprland/workspaces": {
	    "format": "{name}: {icon}",
	    "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": "",
            "active": "",
            "default": ""
	    },
       "persistent-workspaces": {
             "*": 5, // 5 workspaces by default on every monitor
             "HDMI-A-1": 3 // but only three on HDMI-A-1
       }
    },

    "tray": {
        "icon-size": 21,
        "spacing": 10
    },

    "pulseaudio": {
        "format": "{volume}%  {icon}",
        "format-bluetooth": "{volume}% {icon}",
        "format-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "phone-muted": "",
            "portable": "",
            "car": "",
            "default": ["", ""]
        },
        "scroll-step": 1,
        "on-click": "pavucontrol",
        "ignored-sinks": ["Easy Effects Sink"]
    },

    "network": {
        "interface": "wlan0",
        "format": "{ifname}",
        "format-wifi": "({bandwidthDownBytes}) || {essid}  "  ,
        "format-ethernet": "{ipaddr}/{cidr} 󰊗",
        "format-disconnected": "", //An empty format will hide the module.
        "tooltip-format": "{ifname} via {gwaddr} 󰊗",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
        "tooltip-format-ethernet": "{ifname} ",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 50,
        "interval":1
    },

    "custom/notification": {
        "tooltip": true,
        "format": "<span size='16pt'>{icon}</span>",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂜",
            "dnd-notification": "󰂠",
            "dnd-none": "󰪓",
            "inhibited-notification": "󰂛",
            "inhibited-none": "󰪑",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰪑"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    "memory": {
        "interval": 30,
        "format": "{used:0.1f} G / {total:0.1f} G "
    },

    "cpu": {
        "interval": 1,
        "format": "{usage}%  ",
        "max-length": 20
    }
}
